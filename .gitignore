# Local Python environment
.venv/
__pycache__/
*.py[cod]

# Runtime data and historical development captures
runs/
outputs/
work/
dist/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local overrides
.env
config.local.*

# Local Codex handoff and development notes
AGENTS.md
CONTEXT_FOR_CODEX.md
NEXT_SESSION.md
CHANGELOG.md
# Review write-ups are the durable record of every finding that was not
# fixed on the spot - reason, plan and evidence - so they are tracked.
# The rest of docs/ stays local. Git cannot re-include a file from an
# excluded DIRECTORY, hence docs/* rather than docs/.
docs/*
!docs/review-*.md
